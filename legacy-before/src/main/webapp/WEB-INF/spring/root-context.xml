<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- 운영 DB 계정이 소스에 그대로 박혀 있다 -->
    <bean id="dataSource" class="org.apache.commons.dbcp.BasicDataSource" destroy-method="close">
        <property name="driverClassName" value="oracle.jdbc.driver.OracleDriver"/>
        <property name="url" value="jdbc:oracle:thin:@10.0.0.12:1521:ORCL"/>
        <property name="username" value="board"/>
        <property name="password" value="board1234"/>
    </bean>

    <bean id="boardDAO" class="com.company.board.dao.BoardDAO">
        <property name="dataSource" ref="dataSource"/>
    </bean>
</beans>
